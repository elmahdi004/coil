# Quicksort, building fresh arrays with the standard library.
fn qsort(a) {
    if (len(a) <= 1) { return a; }
    let pivot = a[0];
    let less = [];
    let more = [];
    for (let i = 1; i < len(a); i = i + 1) {
        if (a[i] < pivot) { push(less, a[i]); } else { push(more, a[i]); }
    }
    return concat(concat(qsort(less), [pivot]), qsort(more));
}

let data = [5, 2, 8, 1, 9, 3, 7, 4, 6, 0];
print join(qsort(data), " ");
